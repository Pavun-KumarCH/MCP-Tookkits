{
  "application": {
    "name": "File Operations MCP",
    "version": "1.0.0"
  },
  "settings": {
    "data_directory": "./data",
    "supported_formats": ["txt", "json", "pdf", "doc", "docx"],
    "max_file_size": "10MB",

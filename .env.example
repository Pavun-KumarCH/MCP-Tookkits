# ============================================================================
# Email Operations Tool Configuration
# ============================================================================
# Gmail/Email credentials for Email Operations MCP
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_APP_PASSWORD=your-app-password-here  # Alternative name for EMAIL_PASSWORD

# IMAP Server Configuration (defaults to Gmail if not set)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# SMTP Server Configuration (defaults to Gmail if not set)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ============================================================================
# API Caller Tool Configuration (Optional)
# ============================================================================
# API keys for external services (if needed)
# API_KEY=your-api-key-here
# API_SECRET=your-api-secret-here

# ============================================================================
# File Operations Tool Configuration (Optional)
# ============================================================================
# Data directory path (defaults to ./data if not set)
# DATA_DIR=./data

# ============================================================================
# Time & Scheduler Tool Configuration
# ============================================================================
# Default timezone (optional, defaults to system timezone)
# DEFAULT_TIMEZONE=UTC

# ============================================================================
# General Configuration
# ============================================================================
# Python path (if needed)
# PYTHONPATH=/path/to/project

# Debug mode (set to 1 to enable debug logging)
# DEBUG=0

# ============================================================================
# Notes:
# ============================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control (it's in .gitignore)
# 3. For Gmail App Passwords:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Generate an app password for "Mail"
#    - Use the 16-character password (no spaces) as EMAIL_PASSWORD
# 4. For other email providers:
#    - Gmail: imap.gmail.com:993, smtp.gmail.com:587
#    - Outlook: outlook.office365.com:993, smtp.office365.com:587
#    - Yahoo: imap.mail.yahoo.com:993, smtp.mail.yahoo.com:587
#    - Custom: Set IMAP_SERVER and SMTP_SERVER accordingly

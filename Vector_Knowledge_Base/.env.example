# Vector Knowledge Base Tool Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Milvus Vector Database Configuration
# ============================================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=vector_knowledge_base

# ============================================================================
# Embedding Configuration
# ============================================================================
# Ollama API settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-embedding:8b

# Embedding dimension (for qwen3-embedding:8b, use 4096)
# Leave unset or empty to auto-detect from model (recommended)
EMBEDDING_DIMENSION=4096

# ============================================================================
# File Ingestion Configuration
# ============================================================================
# Default path to folder containing .txt files for ingestion
# Can be absolute path or relative to the project root
DEFAULT_TEXT_FOLDER=../Document_Parser_MCP/data/extracted/text

# Default chunking parameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# ============================================================================
# Logging Configuration (optional)
# ============================================================================
# LOG_LEVEL=INFO

# ============================================================================
# Timeout Configuration
# ============================================================================
# Ollama API timeout in seconds (default: 300 = 5 minutes)
# Increase if processing very large texts
OLLAMA_TIMEOUT=300

# Milvus operation timeout in seconds (default: 60)
MILVUS_TIMEOUT=60

# SQL/DB Query Tool Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Database Type Configuration
# ============================================================================
# Supported types: sqlite, postgresql, mysql, mongodb
DB_TYPE=sqlite

# ============================================================================
# Security Configuration
# ============================================================================
# Read-only mode (true/false) - prevents write operations
READ_ONLY=true

# Maximum rows returned per query (prevents large result sets)
MAX_ROWS=1000

# Query timeout in seconds
QUERY_TIMEOUT=30

# ============================================================================
# SQLite Configuration
# ============================================================================
# Path to SQLite database file (relative or absolute)
# For Docker: use volume mount path
SQLITE_DATABASE_PATH=./data/database.db

# ============================================================================
# PostgreSQL Configuration
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ============================================================================
# MySQL/MariaDB Configuration
# ============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mysql
MYSQL_USER=root
MYSQL_PASSWORD=

# ============================================================================
# MongoDB Configuration
# ============================================================================
# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=test
